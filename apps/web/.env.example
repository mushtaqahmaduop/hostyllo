# Base URL of the Hostyllo API. Read at RUNTIME on the server only — never inlined into the client
# bundle, because the browser talks exclusively to this app's own route handlers.
#
#   local dev      http://localhost:3001
#   staging        https://hostyllo-staging.up.railway.app
#   production     https://hostyllo-production.up.railway.app  (→ https://api.hostyllo.app once DNS is set)
API_BASE_URL=http://localhost:3001
